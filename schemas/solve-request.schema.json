{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SolveRequest",
  "type": "object",
  "required": ["task"],
  "properties": {
    "task": { "type": "string", "minLength": 1, "maxLength": 2000, "description": "Natural-language description of intent" },
    "mode": { "type": "string", "enum": ["flash", "focus", "dive", "monitor"] },
    "skill": { "type": "string" },
    "inputs": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["click", "type", "wait_for", "scroll", "extract", "fill_credential"] },
              "selector": { "type": "string" },
              "text": { "type": "string" },
              "field": { "type": "string", "enum": ["username", "secret"] },
              "amount": { "type": "integer" },
              "timeout_ms": { "type": "integer" }
            }
          }
        },
        "credential_id": { "type": "string", "description": "Opaque tenant-scoped browser credential ID; raw credentials are never accepted." },
        "session_state_id": { "type": "string", "description": "Opaque tenant- and origin-bound encrypted browser session-state ID." }
      }
    },
    "webhook_url": { "type": "string", "format": "uri" },
    "idempotency_key": { "type": "string" },
    "output_format": { "type": "string", "enum": ["text", "comparison", "timeline", "json"], "default": "text" }
  }
}
