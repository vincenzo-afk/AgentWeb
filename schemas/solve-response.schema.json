{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SolveResponse",
  "type": "object",
  "definitions": {
    "ResponseMetadata": {
      "type": "object",
      "required": ["request_id", "api_version", "path", "deprecated"],
      "properties": {
        "request_id": { "type": "string" },
        "api_version": { "type": "string", "enum": ["v1"] },
        "path": { "type": "string" },
        "deprecated": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "_meta": { "$ref": "#/definitions/ResponseMetadata" },
    "execution_id": { "type": "string" },
    "mode": { "type": "string", "enum": ["flash", "focus", "dive"] },
    "answer": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "snippet": { "type": "string" },
          "trust_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "cited": { "type": "boolean" }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_span": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "insufficient_evidence": { "type": "boolean" },
    "output_format": { "type": "string", "enum": ["text", "comparison", "timeline", "json"] },
    "evidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "observations"],
        "properties": {
          "field": { "type": "string" },
          "observations": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "structured_output": { "type": "object" }
  }
}
