{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SolveResponse",
  "type": "object",
  "definitions": {
    "ResponseMetadata": {
      "type": "object",
      "required": ["request_id", "api_version", "path", "deprecated"],
      "properties": {
        "request_id": { "type": "string" },
        "api_version": { "type": "string", "enum": ["v1"] },
        "path": { "type": "string" },
        "deprecated": { "type": "boolean" }
      }
    },
    "PlanSummary": {
      "type": "object",
      "required": ["id", "intent", "estimated_mode", "steps", "routed_tools"],
      "properties": {
        "id": { "type": "string" },
        "intent": { "type": "string", "enum": ["lookup", "comparison", "monitoring", "longitudinal"] },
        "estimated_mode": { "type": "string", "enum": ["flash", "focus", "dive", "monitor"] },
        "skill": { "type": ["string", "null"] },
        "steps": { "type": "array", "items": { "type": "object", "required": ["type"], "properties": { "type": { "type": "string" } } } },
        "routed_tools": { "type": "array", "items": { "type": "string" } }
      }
    },
    "SelectionLogic": {
      "type": "object",
      "required": ["source_strategy", "memory_reuse_window_seconds", "ranker", "source_limit"],
      "properties": {
        "source_strategy": { "type": "string" },
        "memory_reuse_window_seconds": { "type": "integer", "minimum": 0 },
        "ranker": { "type": "string" },
        "source_limit": { "type": "integer", "minimum": 1 },
        "include_all_evidence": { "type": "boolean" },
        "adaptive_rounds": { "type": "integer", "minimum": 0 }
      }
    },
    "ResearchTrace": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["flash", "focus", "dive", "monitor"] },
        "waves": { "type": "array", "items": { "type": "object" } },
        "queries": { "type": "array", "items": { "type": "string" } },
        "stop_reason": { "type": "string" },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "ranked_count": { "type": "integer", "minimum": 0 },
        "selected_count": { "type": "integer", "minimum": 0 },
        "final_evidence": { "type": "object" },
        "policy": { "type": "object" },
        "model_router": { "type": "object" }
      }
    },
    "ExecutionAction": {
      "type": "object",
      "required": ["tool", "operation", "status"],
      "properties": {
        "tool": { "type": "string" },
        "operation": { "type": "string" },
        "status": { "type": "string" },
        "call_count": { "type": "integer" },
        "result_count": { "type": "integer" },
        "candidate_count": { "type": "integer" },
        "included_count": { "type": "integer" },
        "source_id": { "type": ["string", "null"] },
        "selected_source_ids": { "type": "array", "items": { "type": "string" } },
        "citation_count": { "type": "integer" },
        "evidence_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "properties": {
    "_meta": { "$ref": "#/definitions/ResponseMetadata" },
    "plan": { "$ref": "#/definitions/PlanSummary" },
    "selection_logic": { "$ref": "#/definitions/SelectionLogic" },
    "actions": { "type": "array", "items": { "$ref": "#/definitions/ExecutionAction" } },
    "execution_id": { "type": "string" },
    "mode": { "type": "string", "enum": ["flash", "focus", "dive", "monitor"] },
    "answer": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "snippet": { "type": "string" },
          "trust_score": { "type": "number", "minimum": 0, "maximum": 1 },
          "cited": { "type": "boolean" },
          "published_at": { "type": ["string", "null"] },
          "content_type": { "type": ["string", "null"] },
          "extraction_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "structured_data": { "type": ["object", "null"] }
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_span": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
          "source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "insufficient_evidence": { "type": "boolean" },
    "output_format": { "type": "string", "enum": ["text", "comparison", "timeline", "json"] },
    "evidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "observations"],
        "properties": {
          "field": { "type": "string" },
          "observations": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "structured_output": { "type": "object" },
    "research_trace": { "$ref": "#/definitions/ResearchTrace" },
    "evidence_gaps": { "type": "array", "items": { "type": "string" } },
    "stop_reason": { "type": ["string", "null"] },
    "next_research_actions": { "type": "array", "items": { "type": "string" } }
  }
}
