{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrowserRequest",
  "type": "object",
  "required": ["url"],
  "properties": {
    "url": { "type": "string", "format": "uri" },
    "actions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["click", "type", "wait_for", "scroll", "extract"] },
          "selector": { "type": "string" },
          "text": { "type": "string" },
          "attribute": { "type": "string" },
          "state": { "type": "string", "enum": ["attached", "detached", "visible", "hidden"] },
          "amount": { "type": "integer" }
        }
      }
    }
  }
}
