{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Monitor",
  "type": "object",
  "definitions": {
    "ResponseMetadata": {
      "type": "object",
      "required": ["request_id", "api_version", "path", "deprecated"],
      "properties": {
        "request_id": { "type": "string" },
        "api_version": { "type": "string", "enum": ["v1"] },
        "path": { "type": "string" },
        "deprecated": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "_meta": { "$ref": "#/definitions/ResponseMetadata" },
    "id": { "type": "string" },
    "org_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "task": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "paused", "cancelled"] },
    "frequency": { "type": "string", "enum": ["minutely", "hourly", "daily"] },
    "webhook_url": { "type": "string", "format": "uri" },
    "last_checked_at": { "type": "string", "format": "date-time" },
    "last_change_at": { "type": "string", "format": "date-time" },
    "last_event": { "type": "string", "enum": ["no_change", "change_detected", "check_failed"] },
    "last_error": { "type": "string" },
    "last_delivery_id": { "type": "string" },
    "last_delivery_status": { "type": "string", "enum": ["pending", "retrying", "rate_limited", "delivered", "dead_letter", "blocked"] },
    "last_delivery_attempts": { "type": "integer", "minimum": 0, "maximum": 5 },
    "last_delivery_error": { "type": "string" }
  }
}
